# Instalar em /etc/logrotate.d/nginx-rc2
# Logs de acesso dos sites públicos (IP já anonimizado na gravação).
# Guardados ~13 meses para a estatística anual; depois são apagados.
/var/log/nginx-rc2/*.log {
    daily
    rotate 400
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        [ -s /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)"
    endscript
}
